# Shared
APP_ENV=development
APP_NAME=Nivra

# Backend
BACKEND_PORT=8080
# DB_DRIVER selects the database engine: "postgres" (production / docker compose)
# or "sqlite" (zero-setup local dev). With sqlite, DATABASE_URL is a file path.
DB_DRIVER=postgres
DATABASE_URL=postgres://nivra:nivra@postgres:5432/nivra?sslmode=disable
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
FRONTEND_URL=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

